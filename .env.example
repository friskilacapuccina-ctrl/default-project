# Neon Postgres — ambil dari dashboard Neon (Connect):
# - DATABASE_URL = pooled connection (port 6543, ada "-pooler", tambahkan ?pgbouncer=true)
# - DIRECT_URL   = direct connection (port 5432, untuk migrate)
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx-pooler.ap-southeast-1.aws.neon.tech:6543/biolearn_ai?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxx.ap-southeast-1.aws.neon.tech:5432/biolearn_ai?sslmode=require"

# OpenAI (wajib untuk AI Tutor; tanpa key, AI memakai mode fallback edukatif)
OPENAI_API_KEY="your_openai_api_key"

# Secret untuk JWT session (minimal 32 karakter random)
AUTH_SECRET="ganti-dengan-minimal-32-karakter-random"

# Pemulihan kata sandi (email melalui Resend)
RESEND_API_KEY="re_xxxxxxxxx"
MAIL_FROM="BioLearn AI <noreply@domain-anda.id>"
APP_URL="http://localhost:3000"

# Opsional — seed:
# SEED_PASSWORD     : password untuk akun demo (teacher01..03, student01..20).
# SEED_ADMIN_PASSWORD: di produksi, akun demo hanya dibuat bila variabel ini di-set.
# SEED_PASSWORD="Biolearn123"
